{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PseudoMarketsDb": "Host=localhost;Port=5432;Database=pseudomarkets_db;Username=postgres;Password=postgres"
  },
  "BatchProcessing": {
    "Enabled": true,
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "ReadOnly": false
    },
    "Server": {
      "WorkerCount": 5,
      "Queues": [ "default" ],
      "ServerName": "pseudomarkets-platform-batch-host"
    },
    "Storage": {
      "SchemaName": "hangfire",
      "QueuePollIntervalSeconds": 15,
      "InvisibilityTimeoutMinutes": 30
    },
    "Jobs": {
      "queued-order-execution": {
        "Enabled": true,
        "CronExpression": "30 9 * * 1-5",
        "Queue": "default",
        "DisableConcurrentExecution": true,
        "TimeZoneId": "America/New_York"
      }
    }
  },
  "QueuedOrderExecution": {
    "IdentityServerBaseUrl": "http://localhost:5051",
    "OrderExecutionBaseUrl": "http://localhost:8084",
    "SystemAccountLoginId": "",
    "SystemAccountPassword": "",
    "TimeoutSeconds": 30,
    "TokenRefreshBufferSeconds": 60,
    "MaxBatchSize": 1000
  },
  "AllowedHosts": "*"
}
