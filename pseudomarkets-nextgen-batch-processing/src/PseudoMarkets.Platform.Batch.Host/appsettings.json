{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PseudoMarketsDb": "Host=localhost;Port=5432;Database=pseudomarkets_db;Username=postgres;Password=postgres"
  },
  "BatchProcessing": {
    "Enabled": true,
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "ReadOnly": false
    },
    "Server": {
      "WorkerCount": 5,
      "Queues": [ "default" ],
      "ServerName": "pseudomarkets-platform-batch-host"
    },
    "Storage": {
      "SchemaName": "hangfire",
      "QueuePollIntervalSeconds": 15,
      "InvisibilityTimeoutMinutes": 30
    },
    "Jobs": {}
  },
  "AllowedHosts": "*"
}
